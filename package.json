{
  "name": "ascandir-charactereditor",
  "productName": "Ascandir - CharacterEditor",
  "version": "0.8.6",
  "description": "D&D 5e Character Editor with 5e.tools data and 3D designer",
  "author": "Ascandir",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node --test tests/engine.test.mjs",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "7zip-bin": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "vite": "^5.4.21"
  },
  "build": {
    "appId": "de.ascandir.charactereditor",
    "productName": "Ascandir - CharacterEditor",
    "copyright": "Ascandir",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Ascandir-CharacterEditor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ascandir - CharacterEditor",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Ascandir - CharacterEditor",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ascandir",
        "repo": "Ascandir---CharacterEditor",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "7za.exe"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ascandir/Ascandir---CharacterEditor.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
